# Copier ce fichier en .env.local et remplir les valeurs (ne jamais committer .env.local).
# En ligne, ces variables sont réglées dans Vercel → Settings → Environment Variables (Production + Preview).

# Supabase — Project Settings > API Keys. Valeurs publiques : la sécurité repose sur la RLS (ADR-01).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Tests e2e uniquement, base locale (npx supabase status) : jamais la clé de production.
# E2E_SUPABASE_SECRET_KEY=

# Prix eBay (US-25, ADR-17) — developer.ebay.com > Application Keys, jeu de clés Production. Serveur seulement.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
